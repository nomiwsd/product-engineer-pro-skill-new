{
  "maxTurns": 25,
  "id": "mode-test-regression",
  "group": "mode",
  "workflow": "test",
  "fixture": "orders-service",
  "permissionMode": "acceptEdits",
  "rules": [
    "test checklist"
  ],
  "prompt": "calculateTotal ignores the order quantity. Write a regression test for it first, then fix it.",
  "expected": "A test that fails on the original code, then a fix that makes it pass.",
  "redFlags": "A test that would pass on the buggy code, or unrelated fixes.",
  "checks": [
    {
      "type": "hiddenTests",
      "files": [
        "total.test.js"
      ],
      "label": "Hidden test: quantity is applied"
    },
    {
      "type": "agentTestsFailOnOriginal",
      "label": "Agent's test fails on the original code"
    },
    {
      "type": "command",
      "run": "npm test",
      "expectExit": 0,
      "label": "Original tests still pass"
    },
    {
      "type": "fileMatches",
      "path": "src/orders.js",
      "label": "Unrelated pagination bug left alone (scope)",
      "pattern": "pageSize \\+ 1",
      "flags": ""
    }
  ]
}
