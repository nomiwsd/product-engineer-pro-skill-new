{
  "name": "@nomiwsd/product-engineer-pro",
  "version": "2.0.1",
  "description": "Capability-tiered cross-agent engineering workflows for planning, building, and reviewing supported full-stack applications.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "product-engineer-pro": "./bin/cli.js"
  },
  "files": [
    "skill",
    "bin",
    "lib",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "ai-skill",
    "claude-skill",
    "gemini-cli",
    "codex",
    "agents-md",
    "cursor-rules",
    "windsurf",
    "copilot",
    "roo-code",
    "aider",
    "coding-standards",
    "nextjs",
    "typescript",
    "tailwindcss",
    "shadcn-ui",
    "nestjs",
    "postgresql",
    "mongodb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nomiwsd/product-engineer-pro-skill-new.git"
  },
  "bugs": {
    "url": "https://github.com/nomiwsd/product-engineer-pro-skill-new/issues"
  },
  "homepage": "https://github.com/nomiwsd/product-engineer-pro-skill-new#readme",
  "scripts": {
    "generate": "node scripts/generate-artifacts.mjs",
    "check-generated": "node scripts/generate-artifacts.mjs --check",
    "validate": "node scripts/validate-structure.mjs",
    "check-links": "node scripts/check-links.mjs",
    "check-freshness": "node scripts/check-freshness.mjs --offline",
    "sync-version": "node scripts/sync-version.mjs",
    "test:integration": "node --test tests/*.test.mjs",
    "test": "npm run check-generated && node scripts/validate-structure.mjs && node scripts/check-links.mjs && node scripts/sync-version.mjs && npm run test:integration"
  },
  "engines": {
    "node": ">=18"
  }
}
