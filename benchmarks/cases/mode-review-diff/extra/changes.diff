+// GET /orders/export — download orders as CSV for the signed-in user.
+export function exportOrdersHandler(req) {
+  const rows = orders.map((order) => `${order.id},${order.userId},${order.productId},${order.quantity},${order.note}`);
+  return { status: 200, body: ["id,userId,productId,quantity,note", ...rows].join("\n") };
